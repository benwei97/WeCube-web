{
  "expo": {
    "name": "WeCube",
    "slug": "wecube-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wecube",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.wecube.ios",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "WeCube needs photo library access so you can add listing photos and profile pictures."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "WeCube needs photo library access so you can add listing photos and profile pictures."
        }
      ]
    ]
  }
}
