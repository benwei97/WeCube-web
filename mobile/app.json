{
  "expo": {
    "name": "WeCube",
    "slug": "wecube-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wecube",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.wecube.ios",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "WeCube needs photo library access so you can add listing photos and profile pictures."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "WeCube needs photo library access so you can add listing photos and profile pictures."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c522eeac-de82-4e36-8a84-a9dc334c4323"
      }
    }
  }
}
